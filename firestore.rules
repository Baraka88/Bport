
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if user is an admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Chats collection supporting user siloing and admin access
    match /chats/{chatId} {
      // Users can only access their own chat, admins can access all
      allow read, write: if request.auth != null && (request.auth.uid == chatId || isAdmin());

      // Messages inside chat
      match /messages/{messageId} {
        allow read, write: if request.auth != null && (request.auth.uid == chatId || isAdmin());
      }
    }

    // Chat users directory
    match /chat_users/{userId} {
      // Users can manage their own profile, admins can manage all (including delete)
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Public Collections
    match /projects/{id} { allow read: if true; }
    match /images/{id} { allow read: if true; }
    match /technologies/{id} { allow read: if true; }
    match /certificates/{id} { allow read: if true; }
    match /services/{id} { allow read: if true; }

    // Admin moderated areas
    match /inquiries_hire_me/{id} { allow read, write: if isAdmin(); }
    match /inquiries_collaboration/{id} { allow read, write: if isAdmin(); }
    match /comments/{id} { 
      allow read: if true;
      allow write: if request.auth != null || isAdmin();
      allow delete: if isAdmin();
    }

    // Admin roles management
    match /roles_admin/{id} {
      allow read: if request.auth != null;
    }

    // Default deny for everything else unless admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
