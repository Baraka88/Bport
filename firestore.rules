
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Community comments are public read, anyone can create
    match /comments/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // User profiles
    match /chat_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Chats: Users can only see and manage their own chats
    match /chats/{chatId} {
      allow read, write: if request.auth != null && request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid;
    }

    // Chat Messages: Ownership enforced by chatId lookup or direct userId field
    match /chat_messages/{messageId} {
      allow read, write: if request.auth != null && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    // Professional Inquiries
    match /inquiries_hire_me/{id} {
      allow create: if true;
      allow read: if false;
    }
    match /inquiries_collaboration/{id} {
      allow create: if true;
      allow read: if false;
    }
    match /images/{id} {
      allow read: if true;
    }
  }
}
