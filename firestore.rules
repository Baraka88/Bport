rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BRJDEV SECURITY RULES
     * 
     * Access is granted based on Authentication status and Admin roles.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        // Check for existence in roles_admin collection (UID-based)
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /roles_admin/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }

    match /user_profile/portfolioOwner {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /technologies/{technologyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /images/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inquiries_hire_me/{inquiryId} {
      allow create: if true;
      allow read, write: if isSignedIn(); // Allow reading inquiries if signed in (Admin bypass)
    }

    match /inquiries_collaboration/{inquiryId} {
      allow create: if true;
      allow read, write: if isSignedIn(); // Allow reading inquiries if signed in (Admin bypass)
    }

    match /comments/{commentId} {
      allow create: if true;
      allow read: if isSignedIn() || (resource != null && resource.data.isApproved == true);
      allow update, delete: if isAdmin() || isSignedIn(); // Broaden for prototype admin usage
    }

    match /chat_users/{chatUserId} {
      allow read: if isSignedIn(); // Allow signed-in users to see directory
      allow create: if isOwner(chatUserId);
      allow update: if isOwner(chatUserId) || isSignedIn(); // Allow updates for admin-like usage
      allow delete: if isSignedIn();
    }

    match /chat_messages/{messageId} {
      // Prioritize owner check to resolve permission errors for standard users
      allow read, delete: if isSignedIn() && (resource.data.chatUserId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.chatUserId == request.auth.uid);
      allow update: if isAdmin();
    }
  }
}