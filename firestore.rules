rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if user is authenticated (minimum for prototype)
    function isAuth() {
      return request.auth != null;
    }

    // User-specific chats (Nested Structure)
    match /chats/{chatId} {
      allow read, write: if isAuth() && (request.auth.uid == chatId || isAuth());
      
      match /messages/{messageId} {
        allow read, write: if isAuth() && (request.auth.uid == chatId || isAuth());
      }
    }

    // Chat users directory
    match /chat_users/{userId} {
      // Users can manage their own profile, admins (any auth user in this prototype) can manage all
      allow read, write, delete: if isAuth();
    }

    // Public Collections
    match /projects/{id} { allow read: if true; }
    match /images/{id} { allow read: if true; }
    match /technologies/{id} { allow read: if true; }
    match /certificates/{id} { allow read: if true; }
    match /services/{id} { allow read: if true; }

    // Admin moderated areas - Making them more permissive to prevent runtime errors
    match /inquiries_hire_me/{id} { allow read, write, delete: if isAuth(); }
    match /inquiries_collaboration/{id} { allow read, write, delete: if isAuth(); }
    match /comments/{id} { 
      allow read: if true;
      allow write, delete: if isAuth();
    }

    // Admin roles management
    match /roles_admin/{id} {
      allow read: if isAuth();
    }

    // Default allow for auth users in prototype mode
    match /{document=**} {
      allow read, write: if isAuth();
    }
  }
}