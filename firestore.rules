rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if the user is an admin
    // Note: User sample provided role as "admin " (with a space)
    function isAdmin() {
      return request.auth != null && 
        (get(/databases/$(database)/documents/chat_users/$(request.auth.uid)).data.role == "admin" || 
         get(/databases/$(database)/documents/chat_users/$(request.auth.uid)).data.role == "admin ");
    }

    // -------------------
    // chat_users collection
    // -------------------
    match /chat_users/{userId} {
      allow read, write: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == userId
      );
    }

    // -------------------
    // chats collection
    // -------------------
    match /chats/{chatId} {
      allow read, write: if request.auth != null && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    // -------------------
    // chat_messages collection
    // -------------------
    match /chat_messages/{messageId} {
      allow read, write: if request.auth != null && (
        isAdmin() ||
        get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.userId == request.auth.uid
      );
    }

    // PUBLIC COLLECTIONS: Always readable by anyone for portfolio visibility
    match /projects/{id} { allow read: if true; }
    match /images/{id} { allow read: if true; }
    match /technologies/{id} { allow read: if true; }
    match /certificates/{id} { allow read: if true; }
    match /services/{id} { allow read: if true; }
    match /comments/{id} { 
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if isAdmin();
    }

    // INQUIRIES
    match /inquiries_collaboration/{inquiryId} {
      allow read, write: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid == request.resource.data.userId
      );
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}