rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if the user is an admin
    // Note: User provided "role": "admin " (with space)
    function isAdmin() {
      let adminPath = /databases/$(database)/documents/chat_users/$(request.auth.uid);
      return request.auth != null && (
        get(adminPath).data.role == "admin" || 
        get(adminPath).data.role == "admin "
      );
    }

    // Public content access
    match /projects/{id} { allow read: if true; }
    match /images/{id} { allow read: if true; }
    match /technologies/{id} { allow read: if true; }
    match /certificates/{id} { allow read: if true; }
    match /services/{id} { allow read: if true; }

    // User Profile
    match /user_profile/portfolioOwner {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Inquiries
    match /inquiries_hire_me/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
    
    match /inquiries_collaboration/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
    
    // Comments
    match /comments/{id} {
      allow read: if resource.data.isApproved == true || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Chat Users (for Admin check)
    match /chat_users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}