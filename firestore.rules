rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BRJDEV PROTOTYPE RULES
     * 
     * Allows any authenticated user to read and write to all collections.
     * This ensures no permission errors occur during development for logged-in users.
     */

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Explicitly allow public read access for unauthenticated visitors to key areas
    match /projects/{id} { allow read: if true; }
    match /images/{id} { allow read: if true; }
    match /technologies/{id} { allow read: if true; }
    match /certificates/{id} { allow read: if true; }
    match /comments/{id} { 
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Explicitly handle chat messages for the list operation
    match /chat_messages/{id} {
      allow read, list, write: if request.auth != null;
    }
    
    match /chat_users/{id} {
      allow read, list, write: if request.auth != null;
    }
  }
}