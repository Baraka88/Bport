rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if the user is an admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // USERS: Users can manage their own profile, admins can see all.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && isAdmin();
    }

    // CHATS: Only owner or admin can read/write chat headers.
    match /chats/{chatId} {
      allow read, write: if request.auth != null && (request.auth.uid == chatId || isAdmin());

      // Messages inside chat: Only owner (via parent chatId check) or admin can read/write.
      match /messages/{messageId} {
        allow read, write: if request.auth != null && (request.auth.uid == chatId || isAdmin());
      }
    }

    // PUBLIC COLLECTIONS: Always readable by anyone.
    match /projects/{id} { allow read: if true; }
    match /images/{id} { allow read: if true; }
    match /technologies/{id} { allow read: if true; }
    match /certificates/{id} { allow read: if true; }
    match /services/{id} { allow read: if true; }
    match /comments/{id} { 
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null && isAdmin();
    }

    // INQUIRIES
    match /inquiries_collaboration/{docId} {
      allow read, write: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.userId);
    }

    // Block everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}