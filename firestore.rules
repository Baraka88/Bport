
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public can view comments and create new ones
    match /comments/{id} {
      allow read: if true;
      allow create: if true;
      // Update/Delete usually restricted to author, but keeping it simple for now as per "remove auth" request
      allow update, delete: if false; 
    }

    // Public can create inquiries
    match /inquiries_hire_me/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /inquiries_collaboration/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Gallery images are public
    match /images/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
