
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check ownership based on a 'userId' field in the document
    function isOwner(data) {
      return isAuthenticated() && data.userId == request.auth.uid;
    }

    // Helper to check if user is an administrator
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/chat_users/$(request.auth.uid)).data.role == 'admin' || 
         get(/databases/$(database)/documents/chat_users/$(request.auth.uid)).data.role == 'admin ');
    }

    // User profiles: Only owner or admin can read; only owner can create
    match /chat_users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Chats: Private conversations, admin has global visibility
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (isOwner(resource.data) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data);
      allow update, delete: if isAuthenticated() && (isOwner(resource.data) || isAdmin());
    }

    // Chat Messages: Private messages, admin has global visibility
    match /chat_messages/{messageId} {
      allow read: if isAuthenticated() && (isOwner(resource.data) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data);
      allow update, delete: if isAuthenticated() && (isOwner(resource.data) || isAdmin());
    }

    // Community feedback is public for all to read and participate
    match /comments/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Professional Inquiries: Public create, Admin only read
    match /inquiries_hire_me/{id} {
      allow create: if true;
      allow read: if isAdmin();
    }
    match /inquiries_collaboration/{id} {
      allow create: if true;
      allow read: if isAdmin();
    }
    match /images/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
