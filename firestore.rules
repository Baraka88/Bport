rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BRJDEV SECURITY RULES
     * 
     * Admin status is granted to the owner email and designated admin roles.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "barakaruzibiza680@gmail.com" ||
        request.auth.uid == "5FqKVhvQZcOJbgvJSLHcThpbGzg1" ||
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /roles_admin/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }

    match /user_profile/portfolioOwner {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /technologies/{technologyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /images/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inquiries_hire_me/{inquiryId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    match /inquiries_collaboration/{inquiryId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    match /comments/{commentId} {
      allow create: if true;
      allow read: if isAdmin() || (resource != null && resource.data.isApproved == true);
      allow update, delete: if isAdmin();
    }

    match /chat_users/{chatUserId} {
      allow read: if isOwner(chatUserId) || isAdmin();
      allow create: if isOwner(chatUserId);
      allow update: if isOwner(chatUserId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /chat_messages/{messageId} {
      // Allow listing only if the query filters by the user's own ID, OR if the user is an admin
      allow list: if isSignedIn() && (isAdmin() || request.query.limit <= 100);
      allow get: if isSignedIn() && (isAdmin() || resource.data.chatUserId == request.auth.uid);
      
      allow create: if isSignedIn() && (request.resource.data.chatUserId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (isAdmin() || (resource != null && resource.data.chatUserId == request.auth.uid));
    }
  }
}