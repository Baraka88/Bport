rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getRole() {
      return get(/databases/$(database)/documents/chat_users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/chat_users/$(request.auth.uid)) &&
             (getRole() == "admin" || getRole() == "admin ");
    }

    // -------------------
    // chat_users collection
    // -------------------
    match /chat_users/{userId} {
      allow read, write: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == userId
      );
    }

    // -------------------
    // chats collection
    // -------------------
    match /chats/{chatId} {
      allow read, write: if request.auth != null && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    // -------------------
    // chat_messages collection
    // -------------------
    match /chat_messages/{messageId} {
      allow read, write: if request.auth != null && (
        isAdmin() ||
        // User can read/write messages in their own chats
        (exists(/databases/$(database)/documents/chats/$(resource.data.chatId)) && 
         get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.userId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId)) && 
         get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.userId == request.auth.uid)
      );
    }

    // -------------------
    // Inquiry collections
    // -------------------
    match /inquiries_collaboration/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
    
    match /inquiries_hire_me/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // -------------------
    // Comments collection
    // -------------------
    match /comments/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}