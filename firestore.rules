rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BRJDEV SECURITY RULES
     *
     * CORE PHILOSOPHY:
     * This ruleset implements a robust "Admin-Managed Portfolio" model combined with an "Authenticated Chat" system. 
     * Security is enforced through Database-Backed Access Control (DBAC) for administrators and 
     * strict ownership/authentication checks for chat participants.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) ||
        request.auth.token.email == "barakaruzibiza680@gmail.com"
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    match /roles_admin/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if false; 
    }

    match /user_profile/portfolioOwner {
      allow get, list: if true;
      allow update: if isAdmin() && resource != null;
      allow create, delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /technologies/{technologyId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /images/{imageId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /inquiries_hire_me/{inquiryId} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }

    match /inquiries_collaboration/{inquiryId} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow create: if true;
      allow get, list: if isAdmin() || resource.data.isApproved == true;
      allow update, delete: if isAdmin();
    }

    match /chat_users/{chatUserId} {
      allow get: if isOwner(chatUserId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(chatUserId);
      allow update: if isExistingOwner(chatUserId);
      allow delete: if isAdmin();
    }

    match /chat_messages/{messageId} {
      allow get, list: if isSignedIn();
      // Allow users to create messages for themselves or trigger system-ai (stored under their UID)
      allow create: if isSignedIn() && (request.resource.data.chatUserId == request.auth.uid);
      allow update: if isAdmin();
      // Allow users to delete their own conversation history
      allow delete: if isSignedIn() && (resource.data.chatUserId == request.auth.uid || isAdmin());
    }
  }
}
