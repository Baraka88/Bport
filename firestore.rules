
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return get(/databases/$(database)/documents/chat_users/$(request.auth.uid)).data.role == "admin ";
    }

    match /chat_users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null; // For liking
      allow delete: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }

    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
