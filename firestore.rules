
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public content access
    match /projects/{id} { allow read: if true; }
    match /images/{id} { allow read: if true; }
    match /technologies/{id} { allow read: if true; }
    match /certificates/{id} { allow read: if true; }
    match /services/{id} { allow read: if true; }

    // User Profile
    match /user_profile/portfolioOwner {
      allow read: if true;
    }

    // Inquiries - Allow anyone to create, no one to read (since admin panel is gone)
    match /inquiries_hire_me/{id} {
      allow create: if true;
    }
    
    match /inquiries_collaboration/{id} {
      allow create: if true;
    }
    
    // Comments - Allow anyone to create and read (auto-approval logic since admin is gone)
    match /comments/{id} {
      allow read: if true;
      allow create: if true;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
