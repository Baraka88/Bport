
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "barakaruzibiza680@gmail.com" ||
        get(/databases/$(database)/documents/chat_users/$(request.auth.uid)).data.role == "admin "
      );
    }

    // Public content access
    match /projects/{id} { allow read: if true; }
    match /images/{id} { allow read: if true; }
    match /technologies/{id} { allow read: if true; }
    match /certificates/{id} { allow read: if true; }
    match /services/{id} { allow read: if true; }
    match /user_profile/{id} { allow read: if true; }

    // Inquiries - Anyone can create, only admin can read/manage
    match /inquiries_hire_me/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
    
    match /inquiries_collaboration/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
    
    // Comments - Anyone can create, public reads only approved, admin reads all
    match /comments/{id} {
      allow read: if isAdmin() || resource.data.isApproved == true;
      allow create: if true;
      allow delete, update: if isAdmin();
    }

    // Admin Users
    match /chat_users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
