rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BRJDEV ULTIMATE PERMISSIVE RULES (Prototype Mode)
     * 
     * This set of rules is designed to ensure NO permission errors during development.
     * It allows any authenticated user to read and write to all collections.
     */

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Explicitly allow public collections for unauthenticated users if necessary
    match /projects/{id} { allow read: if true; }
    match /images/{id} { allow read: if true; }
    match /technologies/{id} { allow read: if true; }
    match /certificates/{id} { allow read: if true; }
    match /comments/{id} { allow read: if true; }
  }
}