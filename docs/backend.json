
{
  "entities": {
    "Comment": {
      "title": "Comment",
      "type": "object",
      "properties": {
        "authorName": { "type": "string" },
        "commentText": { "type": "string" },
        "projectId": { "type": "string" },
        "userId": { "type": "string" },
        "parentId": { "type": "string" },
        "likes": { "type": "array", "items": { "type": "string" } },
        "submissionDate": { "type": "string", "format": "date-time" }
      },
      "required": ["authorName", "commentText", "submissionDate"]
    },
    "ChatUser": {
      "title": "ChatUser",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string" },
        "joinDate": { "type": "string", "format": "date-time" },
        "role": { "type": "string" }
      }
    },
    "Chat": {
      "title": "Chat",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "ai"] },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Community feedback."
    },
    "/chat_users/{userId}": {
      "schema": "ChatUser",
      "description": "Registered chat participants."
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Conversation headers."
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Individual messages in conversations."
    }
  }
}
