
{
  "entities": {
    "Comment": {
      "title": "Comment",
      "type": "object",
      "properties": {
        "authorName": { "type": "string" },
        "commentText": { "type": "string" },
        "projectId": { "type": "string" },
        "userId": { "type": "string" },
        "parentId": { "type": "string" },
        "likes": { "type": "array", "items": { "type": "string" } },
        "submissionDate": { "type": "string", "format": "date-time" }
      },
      "required": ["authorName", "commentText", "submissionDate"]
    },
    "InquiryHire": {
      "title": "InquiryHire",
      "type": "object",
      "properties": {
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string", "format": "email" },
        "clientPhone": { "type": "string" },
        "message": { "type": "string" },
        "serviceIds": { "type": "array", "items": { "type": "string" } },
        "budget": { "type": "string" },
        "timeline": { "type": "string" },
        "urgency": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "viewed", "contacted", "closed"] },
        "submissionDate": { "type": "string", "format": "date-time" }
      }
    },
    "InquiryCollab": {
      "title": "InquiryCollab",
      "type": "object",
      "properties": {
        "collaboratorName": { "type": "string" },
        "collaboratorEmail": { "type": "string", "format": "email" },
        "projectIdea": { "type": "string" },
        "estimatedTimeline": { "type": "string" },
        "status": { "type": "string" },
        "submissionDate": { "type": "string", "format": "date-time" }
      }
    },
    "Chat": {
      "title": "Chat",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "ai"] },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["anonymous", "password"]
  },
  "firestore": {
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Community feedback."
    },
    "/inquiries_hire_me/{id}": {
      "schema": "InquiryHire",
      "description": "Inquiries for hire."
    },
    "/inquiries_collaboration/{id}": {
      "schema": "InquiryCollab",
      "description": "Collaboration proposals."
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "User conversation headers."
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Individual messages within a chat."
    }
  }
}
