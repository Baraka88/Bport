
{
  "entities": {
    "ChatUser": {
      "title": "ChatUser",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "joinDate": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "email", "role", "joinDate"]
    },
    "Chat": {
      "title": "Chat",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "ai"] },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role", "text", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/chat_users/{userId}": {
      "schema": "ChatUser",
      "description": "User profiles and roles."
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat session headers."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Individual messages within a chat session."
    }
  }
}
