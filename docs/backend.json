
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents the portfolio owner's personal and professional information.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "bio": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Project": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "Comment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Comment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorName": { "type": "string" },
        "commentText": { "type": "string" },
        "projectId": { "type": "string" },
        "userId": { "type": "string" },
        "parentId": { "type": "string" },
        "likes": { "type": "array", "items": { "type": "string" } },
        "submissionDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorName", "commentText", "projectId", "userId", "submissionDate"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/chat_users/{userId}": {
      "schema": "UserProfile",
      "description": "User storage for community and admin features."
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Feedback and discussion on portfolio projects."
    }
  }
}
