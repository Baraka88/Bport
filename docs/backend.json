
{
  "entities": {
    "Comment": {
      "title": "Comment",
      "type": "object",
      "properties": {
        "authorName": { "type": "string" },
        "commentText": { "type": "string" },
        "projectId": { "type": "string" },
        "userId": { "type": "string" },
        "parentId": { "type": "string" },
        "likes": { "type": "array", "items": { "type": "string" } },
        "submissionDate": { "type": "string", "format": "date-time" }
      },
      "required": ["authorName", "commentText", "submissionDate"]
    },
    "InquiryHireMe": {
      "title": "InquiryHireMe",
      "type": "object",
      "properties": {
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string", "format": "email" },
        "clientPhone": { "type": "string" },
        "message": { "type": "string" },
        "serviceIds": { "type": "array", "items": { "type": "string" } },
        "budget": { "type": "string" },
        "timeline": { "type": "string" },
        "urgency": { "type": "string" },
        "submissionDate": { "type": "string", "format": "date-time" }
      },
      "required": ["clientName", "clientEmail", "message", "submissionDate"]
    },
    "InquiryCollab": {
      "title": "InquiryCollab",
      "type": "object",
      "properties": {
        "collaboratorName": { "type": "string" },
        "collaboratorEmail": { "type": "string", "format": "email" },
        "projectIdea": { "type": "string" },
        "submissionDate": { "type": "string", "format": "date-time" }
      },
      "required": ["collaboratorName", "collaboratorEmail", "projectIdea", "submissionDate"]
    }
  },
  "auth": {
    "providers": []
  },
  "firestore": {
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Community feedback and project comments."
    },
    "/inquiries_hire_me/{id}": {
      "schema": "InquiryHireMe",
      "description": "Professional service requests."
    },
    "/inquiries_collaboration/{id}": {
      "schema": "InquiryCollab",
      "description": "Project collaboration proposals."
    }
  }
}
